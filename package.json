  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-vue": "^6.0.2",
    "node": "^26.0.0",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
